{
  "name": "bakr",
  "version": "0.0.0",
  "description": "A daemon that keeps long-lived agents alive inside a directory it is handed, rather than one it mints itself",
  "license": "MIT",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brooswit-factory/bakr.git"
  },
  "homepage": "https://github.com/brooswit-factory/bakr#readme",
  "bugs": {
    "url": "https://github.com/brooswit-factory/bakr/issues"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=9999.0.0"
  }
}
